rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Los admins se identifican por email (no por uid) para poder
    // "bootstrapear" el primer admin manualmente desde la consola de
    // Firebase sin necesitar conocer su uid: alcanza con crear un
    // documento admins/{email}.
    //
    // callerEmail() usa token.get(...) (acceso seguro) en vez de
    // token.email: alguien autenticado de forma anónima (subastas) no
    // tiene claim de email, y accederlo con ".email" directamente
    // hace explotar la regla entera incluso dentro de un "||", porque
    // el OR de Firestore Rules no hace short-circuit ante errores.
    function callerEmail() {
      return request.auth != null ? request.auth.token.get('email', null) : null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(callerEmail()));
    }

    function isAdmin() {
      return callerEmail() != null &&
        exists(/databases/$(database)/documents/admins/$(callerEmail()));
    }

    function isOwner() {
      return isAdmin() && adminDoc().data.role == 'owner';
    }

    // Eventos: lectura pública solo de aprobados, cualquiera puede proponer
    // uno nuevo (queda "pending"); un admin puede además cargar eventos
    // directamente ya aprobados, y solo un admin edita/borra/aprueba.
    match /events/{eventId} {
      allow read: if resource.data.status == 'approved' || isAdmin();

      allow create: if isAdmin() || (
        request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.keys().hasAll([
          'title', 'description', 'organizer', 'date', 'location',
          'category', 'submittedBy', 'status', 'createdAt'
        ])
      );

      allow update, delete: if isAdmin();
    }

    // Medios de donación: lectura pública solo de los activos.
    match /donations/{donationId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Contenido editable del sitio (Historia de Flopi, Home, etc.).
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lista de administradores: cualquier admin puede ver quiénes son,
    // pero solo un "owner" puede agregar o quitar administradores.
    //
    // Bootstrap: como no puede existir un primer owner sin que alguien ya
    // sea owner, se permite una única excepción: la cuenta dueña del
    // proyecto puede crear su propio documento admins/{su email} con
    // role "owner" desde la pantalla de login (sin tocar la consola de
    // Firebase). Nadie más puede auto-asignarse admin de esta forma: el
    // email tiene que coincidir exactamente con el hardcodeado acá.
    match /admins/{email} {
      allow read: if isAdmin();

      allow create: if isOwner() || (
        callerEmail() == 'vabarreto14@gmail.com'
        && email == 'vabarreto14@gmail.com'
        && request.resource.data.email == 'vabarreto14@gmail.com'
        && request.resource.data.role == 'owner'
      );

      allow update, delete: if isOwner();
    }

    // ---------------------------------------------------------------
    // Subastas. Cualquiera puede ofertar sin crear cuenta (Firebase
    // Anonymous Auth le da un uid), pero la validación de la oferta
    // (monto mínimo, que la pieza siga "live", y la extensión
    // anti-sniping del reloj) la hacen estas reglas, usando
    // request.time — la hora real del servidor, no la del celular de
    // quien oferta.
    //
    // Cada pieza guarda en el propio documento el estado "oficial":
    // currentAmount / minNextBid / endsAt. Ofertar es, en una sola
    // transacción atómica del lado del cliente: (1) crear el documento
    // en auctionBids con status validado abajo, (2) actualizar esos
    // campos cacheados en auctionItems, y (3) guardar el celular en
    // auctionContacts. Las tres reglas se evalúan todas contra el
    // mismo snapshot "antes" de la base, así que no hay forma de que
    // el cliente arme una combinación inconsistente que pase las tres.
    function auctionItemBefore() { return resource.data; }
    function auctionItemAfter() { return request.resource.data; }

    // La pieza se puede actualizar como resultado de una oferta
    // pública válida, además de por un admin.
    function isValidPublicBidUpdate() {
      let before = auctionItemBefore();
      let after = auctionItemAfter();
      let changedKeys = after.diff(before).affectedKeys();
      let allowedKeys = ['currentAmount', 'currentBidderName', 'currentBidderUid', 'minNextBid', 'endsAt', 'bidCount', 'updatedAt'];
      // endsAt/closedAt/createdAt/updatedAt se guardan como epoch-ms
      // (number), no como Timestamp, para poder manejarlos igual en el
      // cliente (Date.now()) y en las reglas: por eso acá se compara
      // siempre contra request.time.toMillis(), nunca contra
      // request.time directamente (son tipos distintos en Rules).
      let nowMs = request.time.toMillis();
      let noExtensionNeeded = before.endsAt - nowMs > before.extendMin * 60000;
      return request.auth != null
        && before.status == 'live'
        && after.status == 'live'
        && nowMs < before.endsAt
        && changedKeys.hasOnly(allowedKeys)
        && after.currentAmount >= before.minNextBid
        && after.minNextBid == after.currentAmount + before.inc
        && after.currentBidderUid == request.auth.uid
        && after.currentBidderName is string && after.currentBidderName.size() > 0
        && after.bidCount == (before.bidCount == null ? 0 : before.bidCount) + 1
        && (
          noExtensionNeeded
            ? after.endsAt == before.endsAt
            : (after.endsAt >= nowMs + before.extendMin * 60000 - 5000
               && after.endsAt <= nowMs + before.extendMin * 60000 + 5000)
        );
    }

    function isValidPublicBidCreate() {
      let b = request.resource.data;
      let item = get(/databases/$(database)/documents/auctionItems/$(b.itemId)).data;
      return request.auth != null
        && b.keys().hasOnly(['itemId', 'name', 'amount', 'uid', 'at', 'annulled', 'manual'])
        && b.uid == request.auth.uid
        && b.at == request.time
        && b.annulled == false
        && b.manual == false
        && b.name is string && b.name.size() > 0
        && item.status == 'live'
        && request.time.toMillis() < item.endsAt
        && b.amount >= item.minNextBid;
    }

    match /auctionItems/{itemId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isValidPublicBidUpdate();
      allow delete: if isAdmin();
    }

    // Historial de ofertas: lectura pública (nombre y monto son
    // públicos), pero solo se puede crear una oferta "a mano" sin ser
    // admin si pasa isValidPublicBidCreate(); anular/restaurar una
    // oferta (o cargarla a mano en nombre de alguien de WhatsApp) es
    // exclusivo del moderador.
    match /auctionBids/{bidId} {
      allow read: if true;
      allow create: if isAdmin() || isValidPublicBidCreate();
      allow update, delete: if isAdmin();
    }

    // El celular de quien oferta: solo lo puede leer un admin. Quien
    // oferta puede guardar su propio contacto (uid del path = su uid),
    // pero no leerlo de vuelta ni leer el de otros.
    match /auctionContacts/{uid}/bids/{bidId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Entradas (Flopi Fest y futuros eventos con control de acceso).
    //
    // Staff del evento: "vendedor" y "puerta" se loguean con la misma
    // cuenta de Google que el resto del panel (mismo patrón que el
    // moderador de subastas), pero quedan en una colección aparte
    // (eventStaff, no admins) para que NO hereden acceso a
    // eventos/donaciones/contenido/administradores. En esta fase ambos
    // roles tienen los mismos permisos de escritura (pueden vender,
    // cobrar, emitir y escanear) -- el campo "role" es solo para
    // mostrar/filtrar en los reportes, no para restringir acciones.
    // "Administrador" de este módulo es el isAdmin() que ya existe
    // (owner + editor), sin un nivel nuevo.
    function eventStaffDoc() {
      return get(/databases/$(database)/documents/eventStaff/$(callerEmail()));
    }

    function isEventStaff() {
      return isAdmin() || (
        callerEmail() != null &&
        exists(/databases/$(database)/documents/eventStaff/$(callerEmail())) &&
        eventStaffDoc().data.active == true
      );
    }

    // Config del evento: nombre, lugar, fecha, precios, capacidad.
    // issuedCount es un contador cacheado que solo se mueve con la
    // aritmética exacta validada en isValidIssueCounterUpdate()/
    // isValidVoidCounterUpdate() de acá abajo (igual patrón que
    // currentAmount en las subastas), o libremente por un admin.
    match /ticketEvents/{ticketEventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidIssueCounterUpdate() || isValidVoidCounterUpdate();

      function isValidIssueCounterUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return isEventStaff()
          && changed.hasOnly(['issuedCount'])
          && after.issuedCount == before.issuedCount + 1
          && before.issuedCount < before.capacity;
      }

      // Anular una entrada libera el cupo. Lo hace un admin (ver
      // "tickets" más abajo), así que acá solo hace falta que la
      // aritmética sea exacta -- isAdmin() ya se cubre en el "allow
      // update" de arriba, esta función es la rama no-admin por si
      // algún día se delega, hoy en la práctica nunca se usa sin admin.
      function isValidVoidCounterUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return isEventStaff()
          && changed.hasOnly(['issuedCount'])
          && after.issuedCount == before.issuedCount - 1
          && before.issuedCount > 0;
      }
    }

    // Personal del evento (vendedor/puerta). Solo un admin agrega o
    // quita; cualquier miembro del staff puede ver la lista (para que,
    // por ejemplo, el admin arme los reportes por vendedor).
    match /eventStaff/{email} {
      allow read: if isEventStaff();
      allow write: if isAdmin();
    }

    // Pedidos. Cualquiera del staff puede crear (el vendedor/puerta
    // queda forzado a sí mismo como sellerUid), y leer los propios;
    // un admin ve y edita todos. Cancelar un pedido es exclusivo de
    // un admin (igual que "anula" en el resto del módulo).
    //
    // "Aplicar" un pago (sumarlo a amountConfirmedTotal y recalcular
    // el status) es una operación aparte de crear el pago -- Firestore
    // Rules no puede validar en una sola transacción que un documento
    // recién creado en ESA MISMA transacción tenga tal o cual valor
    // (cada escritura se valida contra el estado anterior a la
    // transacción, nunca contra lo que escriben sus hermanas). Por eso
    // el cliente hace dos pasos: (1) crear el pago, (2) en una
    // transacción aparte, aplicar SU monto al pedido leyendo el pago ya
    // confirmado con get(). appliedPaymentIds evita que el mismo pago
    // se aplique dos veces si el paso 2 se reintenta.
    match /orders/{orderId} {
      allow read: if isAdmin() || (isEventStaff() && resource.data.sellerUid == request.auth.uid);

      allow create: if isEventStaff() && isValidOrderCreate();
      allow update: if isAdmin() || isValidOrderPaymentBump() || isValidRaffleNumbersUpdate() || isValidAddRaffle();
      allow delete: if false; // los pedidos no se borran, se anulan (status)

      // Todo pedido tiene al menos 1 entrada -- la entrada es lo que da
      // derecho a comprar rifa, no se vende rifa suelta. "collaboration"
      // marca que paga como una entrada normal pero no va a venir -- no
      // cambia nada acá, solo lo lee la pantalla de emisión para no
      // ofrecer el botón de generar el QR. Los números de rifa (el
      // talonario físico real) no se cargan acá: quedan en una lista
      // vacía al crear el pedido y se anotan después con
      // isValidRaffleNumbersUpdate().
      function isValidOrderCreate() {
        let b = request.resource.data;
        let event = get(/databases/$(database)/documents/ticketEvents/$(b.ticketEventId)).data;
        let expectedPrice = b.channel == 'puerta' ? event.priceDoor : event.priceEarly;
        // .get(key, default) porque "rafflePrice" es un campo agregado
        // después -- un ticketEvents creado antes de esta función no lo
        // tiene, y leerlo con ".rafflePrice" a secas revienta la regla
        // entera (mismo motivo que callerEmail() más arriba).
        let rafflePrice = event.get('rafflePrice', 0);
        return b.keys().hasAll([
            'ticketEventId', 'buyerName', 'buyerPhone', 'quantity', 'channel',
            'unitPrice', 'raffleQuantity', 'raffleUnitPrice', 'raffleNumbers',
            'collaboration', 'total', 'sellerUid', 'sellerEmail', 'status',
            'amountConfirmedTotal', 'appliedPaymentIds', 'createdAt'
          ])
          && b.sellerUid == request.auth.uid
          && b.sellerEmail == callerEmail()
          // La entrada da derecho a comprar rifa -- no se vende rifa
          // suelta, por eso quantity (entradas) siempre tiene que ser
          // al menos 1, haya o no números de rifa en el mismo pedido.
          && b.quantity is int && b.quantity > 0
          && b.raffleQuantity is int && b.raffleQuantity >= 0
          && (b.channel == 'anticipada' || b.channel == 'puerta')
          && b.unitPrice == expectedPrice
          && b.raffleUnitPrice == rafflePrice
          && b.raffleNumbers.size() == 0
          && b.collaboration is bool
          && b.total == b.quantity * b.unitPrice + b.raffleQuantity * b.raffleUnitPrice
          && b.status == 'reserved'
          && b.amountConfirmedTotal == 0
          && b.appliedPaymentIds.size() == 0
          && b.createdAt == request.time;
      }

      // Anotar qué número(s) del talonario físico se le entregaron a
      // quien compró rifa. No mueve plata, así que cualquiera del staff
      // lo puede editar (no hace falta que sea quien vendió), las veces
      // que haga falta (se van entregando de a poco).
      function isValidRaffleNumbersUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return isEventStaff() && changed.hasOnly(['raffleNumbers']);
      }

      // Sumar rifa a un pedido que ya existía (incluso pedidos cargados
      // antes de que la rifa existiera como opción, que no tienen el
      // campo raffleQuantity todavía -- por eso .get(key, 0)). Si el
      // pedido ya estaba "paid", el total nuevo puede dejarlo "partial"
      // de nuevo hasta que se cobre la diferencia -- eso no borra
      // ninguna entrada que ya se haya emitido.
      function isValidAddRaffle() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        let event = get(/databases/$(database)/documents/ticketEvents/$(before.ticketEventId)).data;
        let rafflePrice = event.get('rafflePrice', 0);
        let beforeRaffleQty = before.get('raffleQuantity', 0);
        let addedQty = after.raffleQuantity - beforeRaffleQty;
        let confirmed = before.get('amountConfirmedTotal', 0);
        let newTotal = before.total + addedQty * rafflePrice;
        return isEventStaff()
          && before.status != 'cancelled'
          && changed.hasOnly(['raffleQuantity', 'raffleUnitPrice', 'total', 'status'])
          && addedQty is int && addedQty > 0
          && after.raffleUnitPrice == rafflePrice
          && after.total == newTotal
          && after.status == (confirmed >= newTotal ? 'paid' : (confirmed > 0 ? 'partial' : 'reserved'));
      }

      function isValidOrderPaymentBump() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        let newId = after.appliedPaymentIds[after.appliedPaymentIds.size() - 1];
        let payment = get(/databases/$(database)/documents/payments/$(newId)).data;
        let newTotal = before.amountConfirmedTotal + payment.amount;
        return isEventStaff()
          && changed.hasOnly(['amountConfirmedTotal', 'status', 'appliedPaymentIds'])
          && after.appliedPaymentIds.size() == before.appliedPaymentIds.size() + 1
          && !(newId in before.appliedPaymentIds)
          && after.appliedPaymentIds == before.appliedPaymentIds.concat([newId])
          && payment.orderId == orderId
          && payment.receivedByUid == request.auth.uid
          && payment.status == 'confirmed'
          && after.amountConfirmedTotal == newTotal
          && newTotal <= before.total
          && after.status == (newTotal >= before.total ? 'paid' : 'partial');
      }
    }

    // Pagos. Nunca se borran, solo se anulan (status: voided, por un
    // admin). Un pago en efectivo lo carga el staff y queda confirmado
    // al instante (quien lo recibe lo tiene en la mano); una
    // transferencia queda "por confirmar" hasta que un admin la valida
    // contra el banco -- esa confirmación, igual que anular, es
    // exclusiva de un admin.
    //
    // Cuando el pago en efectivo se crea ya confirmado, la misma
    // transacción del cliente también actualiza orders/{orderId} para
    // sumar el monto a amountConfirmedTotal y recalcular el status
    // (reserved/partial/paid) -- la regla de "orders" de abajo valida
    // esa aritmética exacta para que nadie pueda inflarla.
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isEventStaff() && resource.data.receivedByUid == request.auth.uid);

      allow create: if isEventStaff() && isValidPaymentCreate();
      allow update: if isAdmin();
      allow delete: if false;

      function isValidPaymentCreate() {
        let b = request.resource.data;
        let order = get(/databases/$(database)/documents/orders/$(b.orderId)).data;
        return b.keys().hasAll([
            'orderId', 'ticketEventId', 'amount', 'method', 'reference', 'receivedByUid',
            'receivedByEmail', 'status', 'settled', 'createdAt'
          ])
          && b.ticketEventId == order.ticketEventId
          && b.receivedByUid == request.auth.uid
          && b.receivedByEmail == callerEmail()
          && b.amount is number && b.amount > 0
          && order.status != 'cancelled'
          && b.settled == false
          && b.createdAt == request.time
          && (
            (b.method == 'cash' && b.status == 'confirmed')
            || (b.method == 'transfer' && b.status == 'pending_confirm' && b.reference is string && b.reference.size() > 0)
          );
      }
    }

    // Entradas. La emisión (ticket nuevo + +1 en ticketEvents.issuedCount
    // en la misma transacción) la puede hacer cualquiera del staff,
    // respetando el cupo salvo que sea un admin (ver isValidIssueCounterUpdate
    // arriba). El check-in es la parte crítica: la transición
    // issued -> checked_in es atómica contra el mismo snapshot "antes",
    // así que si dos celulares escanean a la vez, el segundo pierde la
    // carrera y su propio cliente le muestra "ya ingresó" (porque su
    // update deja de cumplir before.status == 'issued'). Autorizar un
    // reingreso es la única escritura permitida sobre una entrada que ya
    // está checked_in.
    match /tickets/{ticketId} {
      allow read: if isEventStaff();
      // Lectura pública de UNA entrada puntual por su código largo (URL
      // no adivinable): "get" puntual sí, pero nunca "list" -- así nadie
      // puede enumerar entradas ajenas sin loguearse.
      allow get: if true;

      allow create: if isEventStaff() && isValidTicketCreate();
      allow update: if isAdmin() || isValidCheckIn() || isValidReentry();
      allow delete: if false;

      function isValidTicketCreate() {
        let b = request.resource.data;
        // Una cortesía no tiene pedido detrás (orderId == null); una
        // entrada paga sí, y exige que ESE pedido ya esté totalmente
        // cobrado y confirmado (status == 'paid'). No se limita acá
        // cuántas entradas salen de un mismo pedido -- la pantalla de
        // emisión controla eso contra orderId/quantity; no es una
        // invariante de seguridad (nadie gana nada falseándola), así
        // que no vale la complejidad de otro contador cruzado.
        let orderOk = b.type == 'courtesy'
          ? b.orderId == null
          : get(/databases/$(database)/documents/orders/$(b.orderId)).data.status == 'paid';
        // Chequeo de cupo redundante con isValidIssueCounterUpdate() de
        // ticketEvents (que es la que de verdad serializa la carrera
        // cuando dos personas emiten al mismo tiempo, porque las dos
        // transacciones compiten por ESE documento compartido). Esta
        // copia acá es una red adicional para el uso normal de la app,
        // asumiendo buena fe del staff -- no hay forma 100% hermética
        // de OBLIGAR con solo Rules a que la emisión de la entrada y el
        // +1 del contador viajen siempre juntas sin Cloud Functions.
        let event = get(/databases/$(database)/documents/ticketEvents/$(b.ticketEventId)).data;
        return b.keys().hasAll([
            'ticketEventId', 'orderId', 'code', 'shortCode', 'type', 'status',
            'holderName', 'holderPhone', 'issuedByUid', 'issuedByEmail',
            'reentryCount', 'createdAt'
          ])
          && b.code is string && b.code.size() >= 22
          && b.status == 'issued'
          && (b.type == 'paid' || b.type == 'courtesy')
          && orderOk
          && (event.issuedCount < event.capacity || isAdmin())
          && b.issuedByUid == request.auth.uid
          && b.issuedByEmail == callerEmail()
          && b.reentryCount == 0
          && b.createdAt == request.time;
      }

      function isValidCheckIn() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return isEventStaff()
          && before.status == 'issued'
          && after.status == 'checked_in'
          && changed.hasOnly(['status', 'checkedInAt', 'checkedInByUid', 'checkedInByEmail'])
          && after.checkedInAt == request.time
          && after.checkedInByUid == request.auth.uid
          && after.checkedInByEmail == callerEmail();
      }

      function isValidReentry() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return isEventStaff()
          && before.status == 'checked_in'
          && after.status == 'checked_in'
          && changed.hasOnly(['reentryCount'])
          && after.reentryCount == before.reentryCount + 1;
      }
    }

    // Auditoría: nadie, ni un admin, puede editar o borrar un registro
    // ya creado -- es el historial de "quién, qué y cuándo".
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isEventStaff()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == callerEmail()
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
