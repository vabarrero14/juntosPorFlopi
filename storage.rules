rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Flyers/imágenes de eventos y del contenido general del sitio:
    // lectura pública, escritura solo para administradores.
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
